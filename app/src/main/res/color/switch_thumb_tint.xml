<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- A dark thumb on the gold track keeps the OSRS on-state legible in both themes. -->
    <item android:color="@color/osrs_brown_deep" android:state_checked="true" android:state_enabled="true" />
    
    <!-- Enabled & UNchecked (off state) - this fixes the grey thumb issue -->
    <item android:alpha="0.78" android:color="?attr/colorOnSurface" android:state_checked="false" android:state_enabled="true" />
    
    <!-- Disabled states (optional) -->
    <item android:color="?attr/colorOnSurfaceVariant" android:state_checked="true" />
    <item android:color="?attr/colorOnSurfaceVariant" />
</selector>
