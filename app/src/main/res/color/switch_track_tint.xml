<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Gold is the semantic OSRS accent and remains distinct from the dark parchment surface. -->
    <item android:color="@color/osrs_gold_muted" android:state_checked="true" />
    <!-- Preserve a restrained off state without letting its track disappear in dark mode. -->
    <item android:alpha="0.36" android:color="?attr/colorOnSurfaceVariant" />
</selector>
