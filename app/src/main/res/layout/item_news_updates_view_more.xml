<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="220dp"
    android:minWidth="120dp"
    android:paddingStart="8dp"
    android:paddingEnd="16dp">

    <TextView
        android:id="@+id/home_updates_view_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:contentDescription="@string/home_updates_view_more_content_description"
        android:focusable="true"
        android:text="@string/home_updates_view_more"
        android:textAppearance="@style/AppTextAppearance.Body"
        android:textColor="?attr/linkColor" />

</FrameLayout>
