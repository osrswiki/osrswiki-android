<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <!-- Same link-row pattern as About: title, body, outbound text link.
         Cards were Feedback-only chrome. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/rate_app_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="vertical"
            android:clickable="false"
            android:focusable="false">

            <TextView
                android:id="@+id/rate_app_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/feedback_rate_app_title"
                android:textAppearance="@style/AppTextAppearance.SettingsSubheading"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/rate_app_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/feedback_rate_app_description"
                android:textAppearance="@style/AppTextAppearance.SettingsBody"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rate_app_button"
                style="@style/Widget.OSRSWiki.OutboundLinkButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/feedback_rate_app_button" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/report_issue_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="vertical"
            android:clickable="false"
            android:focusable="false">

            <TextView
                android:id="@+id/report_issue_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/feedback_report_issue_title"
                android:textAppearance="@style/AppTextAppearance.SettingsSubheading"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/report_issue_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/feedback_report_issue_description"
                android:textAppearance="@style/AppTextAppearance.SettingsBody"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/report_issue_button"
                style="@style/Widget.OSRSWiki.OutboundLinkButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/feedback_report_issue_button" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/request_feature_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="vertical"
            android:clickable="false"
            android:focusable="false">

            <TextView
                android:id="@+id/request_feature_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/feedback_request_feature_title"
                android:textAppearance="@style/AppTextAppearance.SettingsSubheading"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/request_feature_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/feedback_request_feature_description"
                android:textAppearance="@style/AppTextAppearance.SettingsBody"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/request_feature_button"
                style="@style/Widget.OSRSWiki.OutboundLinkButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/feedback_request_feature_button" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
