<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:maplibre="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/paper_color"
    tools:context=".ui.map.MapFragment">

    <FrameLayout
        android:id="@+id/map_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/floor_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/control_background_themed"
        android:backgroundTint="@null"
        android:elevation="4dp"
        android:forceDarkAllowed="false"
        android:orientation="vertical"
        android:padding="4dp"
        app:backgroundTint="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/prototype_product_controls"
        tools:visibility="visible">

        <ImageButton
            android:id="@+id/floor_control_up"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/map_floor_up"
            android:src="@drawable/ic_arrow_up"
            app:tint="?attr/map_control_text" />

        <TextView
            android:id="@+id/floor_control_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/map_control_text"
            tools:text="0" />

        <ImageButton
            android:id="@+id/floor_control_down"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/map_floor_down"
            android:src="@drawable/ic_arrow_down"
            app:tint="?attr/map_control_text" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/prototype_product_controls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/control_background_themed"
        android:elevation="5dp"
        android:forceDarkAllowed="false"
        android:orientation="vertical"
        android:padding="4dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <AutoCompleteTextView
                android:id="@+id/prototype_search_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/map_semantic_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:minHeight="48dp"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:singleLine="true"
                android:textColor="?attr/map_control_text"
                android:textColorHint="?attr/map_control_text"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/prototype_search_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/map_semantic_search_action"
                android:padding="12dp"
                android:src="@drawable/ic_search_24"
                app:tint="?attr/map_control_text" />

            <ImageButton
                android:id="@+id/prototype_history_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/map_semantic_history_back"
                android:enabled="false"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="?attr/map_control_text" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/prototype_surface_selector"
                style="?attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/map_semantic_surface_selector_action"
                android:gravity="start|center_vertical"
                android:maxLines="2"
                android:minHeight="48dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/map_semantic_surface_selector"
                android:textAllCaps="false"
                android:textColor="?attr/map_control_text"
                android:textSize="12sp" />

            <Button
                android:id="@+id/prototype_key_toggle"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/map_semantic_key_toggle_action"
                android:maxLines="2"
                android:minHeight="48dp"
                android:minWidth="64dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/map_semantic_key_toggle"
                android:textAllCaps="false"
                android:textColor="?attr/map_control_text"
                android:textSize="12sp" />

            <Button
                android:id="@+id/prototype_overview_toggle"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/map_semantic_overview_action"
                android:maxLines="2"
                android:minHeight="48dp"
                android:minWidth="92dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/map_semantic_overview_on"
                android:textAllCaps="false"
                android:textColor="?attr/map_control_text"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/prototype_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:breakStrategy="simple"
            android:gravity="center_vertical"
            android:hyphenationFrequency="none"
            android:maxLines="4"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:textColor="?attr/map_control_text"
            android:textSize="12sp"
            android:visibility="invisible" />
    </LinearLayout>

    <com.omiyawaki.osrswiki.ui.map.osrsMapPrototypeOverviewView
        android:id="@+id/prototype_overview"
        android:layout_width="168dp"
        android:layout_height="116dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/control_background_themed"
        android:contentDescription="@string/map_semantic_overview_description"
        android:elevation="5dp"
        android:padding="6dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/prototype_product_controls"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/prototype_key_panel"
        android:layout_width="176dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/control_background_themed"
        android:elevation="5dp"
        android:forceDarkAllowed="false"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/prototype_product_controls"
        tools:visibility="visible">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            android:text="@string/map_semantic_key_title"
            android:textColor="?attr/map_control_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/prototype_key_banks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/map_semantic_key_banks"
            android:textColor="?attr/map_control_text"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/prototype_key_transport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/map_semantic_key_transport"
            android:textColor="?attr/map_control_text"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/prototype_key_dungeons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/map_semantic_key_dungeons"
            android:textColor="?attr/map_control_text"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/prototype_key_places"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/map_semantic_key_places"
            android:textColor="?attr/map_control_text"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/prototype_debug_controls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/control_background_themed"
        android:backgroundTint="@null"
        android:elevation="4dp"
        android:forceDarkAllowed="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp"
        android:visibility="gone"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible">

        <Button
            android:id="@+id/prototype_reference_stop"
            style="?attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            android:minHeight="48dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/map_semantic_stop_default"
            android:textAllCaps="false"
            android:textColor="?attr/map_control_text"
            android:textSize="12sp" />

        <Button
            android:id="@+id/prototype_toggle_labels"
            style="?attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            android:minHeight="48dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/map_semantic_labels_on"
            android:textAllCaps="false"
            android:textColor="?attr/map_control_text"
            android:textSize="12sp" />

        <Button
            android:id="@+id/prototype_toggle_pois"
            style="?attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            android:minHeight="48dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/map_semantic_pois_on"
            android:textAllCaps="false"
            android:textColor="?attr/map_control_text"
            android:textSize="12sp" />

        <Button
            android:id="@+id/prototype_toggle_links"
            style="?attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            android:minHeight="48dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/map_semantic_links_on"
            android:textAllCaps="false"
            android:textColor="?attr/map_control_text"
            android:textSize="12sp" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/map_marker_info_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/control_background_themed"
        android:backgroundTint="@null"
        android:contentDescription="@string/map_marker_info_action"
        android:elevation="4dp"
        android:forceDarkAllowed="false"
        android:padding="12dp"
        android:src="@drawable/ic_info_24"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="?attr/map_control_text" />

    <LinearLayout
        android:id="@+id/map_unavailable_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:background="?attr/colorSurface"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <TextView
            android:id="@+id/map_unavailable_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/map_unavailable_title"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/map_unavailable_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/map_unavailable_message"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/map_retry_button"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/map_retry" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
