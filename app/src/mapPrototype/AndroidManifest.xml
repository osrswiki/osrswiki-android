<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission tools:node="removeAll" />
    <!-- MapLibre checks connectivity while initializing even though this map is offline-only. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-feature tools:node="removeAll" />
    <permission tools:node="removeAll" />
    <queries tools:node="removeAll" />

    <application
        android:name="com.omiyawaki.osrswiki.test.MapPrototypeApplication"
        android:label="@string/app_name"
        tools:replace="android:name,android:label">
        <activity tools:node="removeAll" />
        <service tools:node="removeAll" />
        <receiver tools:node="removeAll" />
        <provider tools:node="removeAll" />
        <meta-data tools:node="removeAll" />
        <uses-library tools:node="removeAll" />
        <activity
            android:name="com.omiyawaki.osrswiki.test.MapPrototypeLauncherActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/app_name"
            android:noHistory="true"
            android:screenOrientation="fullUser"
            android:taskAffinity="com.omiyawaki.osrswiki.mapprototype.launcher"
            android:theme="@style/Theme.OSRSWiki.MapPrototype.Trampoline">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.omiyawaki.osrswiki.test.SemanticPrototypeStandaloneActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:screenOrientation="fullUser"
            android:theme="@style/Theme.OSRSWiki.MapPrototype.Launch" />
    </application>
</manifest>
